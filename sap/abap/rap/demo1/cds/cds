@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Manufacturing Order'
define root view entity ZC_PP_ManufacturingOrder
  provider contract transactional_query 
  as projection on ZI_PP_ManufacturingOrder
{
  key ManufacturingOrder,
      ManufacturingOrderCategory,
      ManufacturingOrderType,
      Product,
      ProductName,
      ProductionPlant,
      StorageLocation,
      MfgOrderPlannedTotalQty,
      ProductionUnit,
      MfgOrderPlannedStartDate,
      MfgOrderPlannedEndDate,
      MrpController,
      ProductionSupervisor,
      ProductionVersion,
      ProductionVersionText,
      SalesOrder,
      SalesOrderItem,
      Tdname,
      @ObjectModel.virtualElement: true
      @ObjectModel.virtualElementCalculatedBy: 'ABAP:Z_PP_LONGTEXT_GET'
      virtual LongText: abap.string,
      PlannedOrder,
      Created,
      Released,
      TechnicallyCompleted,
      DeletionFlag,
      DefectiveRatio,
      InventoryUsabilityCode,
      InventoryUsabilityCodeName,
      OrderIssuanceDate,
      Reservation,
      LastChangeTimestamp
}

@EndUserText.label: 'OrderStatus'
@AccessControl.authorizationCheck: #NOT_REQUIRED
@VDM.viewType: #BASIC

define view entity ZI_PP_ACMSystemStatus
  as select from jest
{
  key objnr as ApplicationStatusObject,
  key stat as StatusProfileName,
      inact as ChangeDocumentStatusIsInactive,
      chgnr as ChangeNumber
}

@EndUserText.label: 'LongTextMapping'
@AccessControl.authorizationCheck: #NOT_REQUIRED
@VDM.viewType: #BASIC

define view entity ZI_PP_LongTextMapping
  as select from aufk_text
{
  key aufnr  as ManufacturingOrder,
      tdname as LongTextName
}

@EndUserText.label: 'Production Order Header'
@AccessControl.authorizationCheck: #NOT_REQUIRED
@VDM.viewType: #COMPOSITE
define root view entity ZI_PP_ManufacturingOrder
  as select from    I_ManufacturingOrder  as _MOrder
    left outer join ZI_PP_ACMSystemStatus as _Status2 on  _Status2.ApplicationStatusObject = _MOrder.ObjectInternalID
                                                      and _Status2.StatusProfileName       = 'I0002'
  association [0..1] to I_ProductionVersion          as _PVersion           on  _PVersion.Material          = _MOrder.Product
                                                                            and _PVersion.Plant             = _MOrder.ProductionPlant
                                                                            and _PVersion.ProductionVersion = _MOrder.ProductionVersion
  association [0..1] to I_ProductText                as _PText              on  _PText.Product  = _MOrder.Product
                                                                            and _PText.Language = 'J'
  association [0..1] to I_InventoryUsabilityCodeText as _InvtryText         on  _InvtryText.InventoryUsabilityCode = _MOrder.InventoryUsabilityCode
                                                                            and _InvtryText.Language               = 'J'
  association [0..1] to ZI_PP_ACMSystemStatus        as _Status1            on  _Status1.ApplicationStatusObject = _MOrder.ObjectInternalID
                                                                            and _Status1.StatusProfileName       = 'I0001'
  association [0..1] to ZI_PP_ACMSystemStatus        as _Status45           on  _Status45.ApplicationStatusObject = _MOrder.ObjectInternalID
                                                                            and _Status45.StatusProfileName       = 'I0045'
  association [0..1] to ZI_PP_ACMSystemStatus        as _Status76           on  _Status76.ApplicationStatusObject = _MOrder.ObjectInternalID
                                                                            and _Status76.StatusProfileName       = 'I0076'
  association [0..1] to ZI_PP_LongTextMapping        as _LongTextMapping    on  _MOrder.ManufacturingOrder = _LongTextMapping.ManufacturingOrder

  association [0..1] to I_StatusObjectStatusChange   as _OrderStatusHistory on  _OrderStatusHistory.StatusObject                   = _Status2.ApplicationStatusObject
                                                                            and _OrderStatusHistory.StatusCode                     = _Status2.StatusProfileName
                                                                            and _OrderStatusHistory.StatusObjectStatusChangeNumber = _Status2.ChangeNumber
{
  key _MOrder.ManufacturingOrder             as ManufacturingOrder,
      _MOrder.ManufacturingOrderCategory     as ManufacturingOrderCategory,
      _MOrder.ManufacturingOrderType         as ManufacturingOrderType,
      _MOrder.Product                        as Product,
      _PText.ProductName                     as ProductName,
      _MOrder.ProductionPlant                as ProductionPlant,
      _MOrder.StorageLocation                as StorageLocation,

      @Semantics.quantity.unitOfMeasure: 'ProductionUnit'
      _MOrder.MfgOrderPlannedTotalQty        as MfgOrderPlannedTotalQty,

      _MOrder.ProductionUnit                 as ProductionUnit,
      _MOrder.MfgOrderPlannedStartDate       as MfgOrderPlannedStartDate,
      _MOrder.MfgOrderPlannedEndDate         as MfgOrderPlannedEndDate,
      _MOrder.MRPController                  as MrpController,
      _MOrder.ProductionSupervisor           as ProductionSupervisor,
      _MOrder.ProductionVersion              as ProductionVersion,
      _PVersion.ProductionVersionText        as ProductionVersionText,
      _MOrder.SalesOrder                     as SalesOrder,
      _MOrder.SalesOrderItem                 as SalesOrderItem,
      _LongTextMapping.LongTextName          as Tdname,
      _MOrder.PlannedOrder                   as PlannedOrder,
      case when _Status1.StatusProfileName  is null or _Status1.StatusProfileName = '' then ''
           when _Status1.StatusProfileName  is not null and _Status1.ChangeDocumentStatusIsInactive = 'X'  then ''
           when _Status1.StatusProfileName  is not null and (_Status1.ChangeDocumentStatusIsInactive is null or _Status1.ChangeDocumentStatusIsInactive = '') then 'X'
           else '' end                       as Created,
      case when _Status2.StatusProfileName  is null or _Status1.StatusProfileName = '' then ''
           when _Status2.StatusProfileName  is not null and _Status2.ChangeDocumentStatusIsInactive = 'X'  then ''
           when _Status2.StatusProfileName  is not null and (_Status2.ChangeDocumentStatusIsInactive is null or _Status2.ChangeDocumentStatusIsInactive = '') then 'X'
           else '' end                       as Released,
      case when _Status45.StatusProfileName  is null or _Status45.StatusProfileName = '' then ''
           when _Status45.StatusProfileName  is not null and _Status45.ChangeDocumentStatusIsInactive = 'X'  then ''
           when _Status45.StatusProfileName  is not null and (_Status45.ChangeDocumentStatusIsInactive is null or _Status45.ChangeDocumentStatusIsInactive = '') then 'X'
           else '' end                       as TechnicallyCompleted,
      case when _Status76.StatusProfileName  is null or _Status76.StatusProfileName = '' then ''
           when _Status76.StatusProfileName  is not null and _Status76.ChangeDocumentStatusIsInactive = 'X'  then ''
           when _Status76.StatusProfileName  is not null and (_Status76.ChangeDocumentStatusIsInactive is null or _Status76.ChangeDocumentStatusIsInactive = '') then 'X'
           else '' end                       as DeletionFlag,

      @Semantics.quantity.unitOfMeasure: 'ProductionUnit'
      _MOrder.MfgOrderPlannedScrapQty        as MfgOrderPlannedScrapQty,
      _MOrder.InventoryUsabilityCode         as InventoryUsabilityCode,
      _InvtryText.InventoryUsabilityCodeName as InventoryUsabilityCodeName,
      case when _Status2.ChangeDocumentStatusIsInactive = '' or _Status2.ChangeDocumentStatusIsInactive is null then _OrderStatusHistory.LastChangeDate
           else null end                     as OrderIssuanceDate,
      _MOrder.Reservation                    as Reservation,
      round(
          division(
            cast( _MOrder.MfgOrderPlannedScrapQty as abap.dec(13,3) ),
            ( cast( _MOrder.MfgOrderPlannedTotalQty as abap.dec(13,3) ) - cast( _MOrder.MfgOrderPlannedScrapQty as abap.dec(13,3) ) ),
            5
          ),
          5
        )                                    as DefectiveRatio,

      @Semantics.systemDateTime.lastChangedAt: true
      case
          when _MOrder.LastChangeDate is null
            or substring(_MOrder.LastChangeDate,1,4) = '0000'
          then cast( dats_tims_to_tstmp(
                  _MOrder.CreationDate,
                  _MOrder.CreationTime,
                  abap_system_timezone( $session.client, 'NULL' ),
                  $session.client,
                  'NULL'
               )  as timestampl )
          else cast( dats_tims_to_tstmp(
                  _MOrder.LastChangeDate,
                  _MOrder.LastChangeTime,
                  abap_system_timezone( $session.client, 'NULL' ),
                  $session.client,
                  'NULL'
               ) as timestampl )
      end                                    as LastChangeTimestamp
}